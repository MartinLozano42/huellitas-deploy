PORT=3000

# MySQL / Aiven
DB_HOST=tu-host.aivencloud.com
DB_PORT=12345
DB_NAME=PRMascotas
DB_USER=avnadmin
DB_PASSWORD=TU_PASSWORD_AIVEN

# Aiven SSL
DB_SSL=true
DB_SSL_CA=C:/ruta/a/ca.pem

# JWT
JWT_SECRET=CAMBIAR_ESTA_CLAVE_POR_UNA_LARGA_Y_SEGURA
JWT_EXPIRES_IN=8h

# Primer Admin (solo para npm run seed:admin)
ADMIN_EMAIL=admin@prmascotas.com
ADMIN_PASSWORD=Cambiar123!
ADMIN_NAME=Admin
ADMIN_LASTNAME=PRMascotas
ADMIN_CI=00000000
ADMIN_PHONE=000000000

# URL base que irá codificada en los nuevos QR (debe abrir el frontend público).
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_QR_BASE_URL=http://localhost:5173/qr

# Almacenamiento de imágenes. "local" es para desarrollo; Cloudinary evita llenar el disco del backend.
IMAGE_STORAGE_PROVIDER=local
# Para almacenamiento externo, cambia IMAGE_STORAGE_PROVIDER a cloudinary y completa estas variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=huellitas
